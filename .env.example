# Studix configuration. Copy to .env and fill in; never commit .env.
# Authoritative schema: packages/shared/src/config.ts (loadConfig). Empty values count as unset.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=8787
# Process role in the single image: app (/mcp, /api, dashboard) or worker (job claim loops); unset = app
STUDIX_ROLE=

# --- Public URLs (hostnames are configuration, never code; required in production) ---
# Origin serving /mcp and /api (the MCP endpoint is ${STUDIX_PUBLIC_URL}/mcp)
STUDIX_PUBLIC_URL=http://localhost:8787
# Dashboard origin
STUDIX_APP_URL=http://localhost:8787
# Marketing site origin
STUDIX_MARKETING_URL=http://localhost:4321
# Extra Host header values accepted by the HTTP server (comma-separated); URL hosts above are always allowed
STUDIX_ALLOWED_HOSTS=
# Reverse-proxy hops trusted for the client IP (0 = none; 1 behind one ingress)
STUDIX_TRUST_PROXY=0
# Worker health base URL; the Storage & Media page compares the worker media report with the app.
# STUDIX_WORKER_HEALTH_URL=http://localhost:8081
# OAuth 2.1 for /mcp next to API keys (true | false)
STUDIX_MCP_OAUTH=true
# Built dashboard directory served by the app (default: apps/dashboard/dist)
STUDIX_DASHBOARD_DIST=

# --- Database (docker compose: postgres on 127.0.0.1:55432) ---
DATABASE_URL=postgres://studix:studix@127.0.0.1:55432/studix
# App role: apply pending migrations before listening (true/false)
STUDIX_MIGRATE_ON_START=false

# --- Object storage, any S3-compatible API (docker compose: minio on 127.0.0.1:59000) ---
S3_ENDPOINT=http://127.0.0.1:59000
# Client-facing endpoint used only for signed URLs when S3_ENDPOINT is internal (e.g. http://minio:9000)
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=studix-local
S3_ACCESS_KEY_ID=studix
S3_SECRET_ACCESS_KEY=studix-local-secret
# true for MinIO; false for AWS/R2 virtual-hosted buckets
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=3600

# --- Auth ---
# Environment tag embedded in issued API keys: stx_<env>_<random>
STUDIX_API_KEY_ENV=dev
# Dashboard session signing secret (>= 32 chars), required in production
BETTER_AUTH_SECRET=
# Dashboard sign-in with GitHub / Google (OAuth apps). Set both keys of a provider to enable it; leave both
# empty to keep it off. Callback URLs to register: <STUDIX_APP_URL>/api/auth/callback/github and
# <STUDIX_APP_URL>/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Master key for provider credentials at rest (AES-256-GCM): 32 random bytes, base64
# (openssl rand -base64 32). Unset = saving Anthropic API keys is disabled.
STUDIX_SECRETS_KEY=
# Retired master keys still accepted for decryption during rotation (comma-separated base64)
STUDIX_SECRETS_KEYS_PREVIOUS=
# Anthropic API origin used to test saved keys (GET /v1/models, no tokens spent)
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Let jobs opt into planning with the Claude Agent SDK (app and worker; worker needs STUDIX_SECRETS_KEY)
STUDIX_CLAUDE_PLANNER=false
# Self-hosted/personal servers only: users may connect their own Claude subscription (token from
# `claude setup-token`), run by the Claude Code binary. Needs STUDIX_SECRETS_KEY and STUDIX_CLAUDE_PLANNER.
STUDIX_CLAUDE_SUBSCRIPTION=false
# Self-hosted/personal server only: workspace owners toggle the Claude planner and subscriptions in the
# Dashboard, and a missing STUDIX_SECRETS_KEY is generated into STUDIX_SECRETS_KEY_FILE (share it with the worker).
STUDIX_SELF_HOSTED=false
# STUDIX_SECRETS_KEY_FILE=.studix/secrets.key
# Worker-only Claude planner tuning (defaults shown)
# STUDIX_CLAUDE_PLANNER_MODEL=claude-sonnet-5-5
# STUDIX_CLAUDE_PLANNER_MAX_TURNS=4
# STUDIX_CLAUDE_PLANNER_MAX_COST_CENTS=200
# STUDIX_CLAUDE_PLANNER_TIMEOUT_SECONDS=300

# Optional: raises the GitHub API rate limit for importing public skills (read-only token, sent to api.github.com only)
# STUDIX_GITHUB_TOKEN=

# --- Jobs / worker ---
WORKER_CONCURRENCY=1
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
# Default per-job budget and wall-clock deadline
DEFAULT_JOB_BUDGET_CENTS=500
DEFAULT_JOB_DEADLINE_SECONDS=1800
# Actions estimated above this cost require human approval
APPROVAL_COST_THRESHOLD_CENTS=1000
# Worker health server (/healthz, /readyz); 0 picks a free port
WORKER_HEALTH_PORT=8081
WORKER_HEALTH_HOST=0.0.0.0
# Worker identity in leases and logs (default <hostname>-<pid>)
WORKER_ID=
# Scratch directory for renders. The image sets /var/lib/studix/work (mount a persistent volume there);
# leave this commented out unless you run the worker outside the image (default <tmpdir>/studix-worker)
# WORKER_WORK_DIR=
# Idle delay between queue claims
WORKER_POLL_INTERVAL_MS=1000
# How long SIGTERM waits for running jobs before releasing them
WORKER_SHUTDOWN_GRACE_MS=25000
# Compute cost per rendered second, charged against job budgets (0 until measured)
RENDER_COST_CENTS_PER_SECOND=0

# --- Decision routing (provider ids and model ids are configuration) ---
# Ordered provider chain, e.g. "typesafe,openrouter,rules"
DECISION_PROVIDERS=rules
# Per-decision chains, e.g. "video.brief=openrouter>rules" (kinds separated by ";")
DECISION_ROUTES=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DECISION_MODEL=
# OpenRouter price per million tokens in cents, for cost accounting when the response has no cost
OPENROUTER_INPUT_CENTS_PER_MTOK=
OPENROUTER_OUTPUT_CENTS_PER_MTOK=
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
TYPESAFE_DECISION_MODEL=
# TypeSafe price per million input tokens in cents
TYPESAFE_INPUT_CENTS_PER_MTOK=

# --- MCP gateway (workspace connectors behind studix_tool_search/inspect/execute) ---
# Per-execute deadline and per-workspace concurrency
STUDIX_MCP_GATEWAY_TIMEOUT_MS=20000
STUDIX_MCP_GATEWAY_MAX_CONCURRENCY=4
# Largest inline tool result and largest stored tool input schema (bytes)
STUDIX_MCP_GATEWAY_MAX_RESULT_BYTES=65536
STUDIX_MCP_GATEWAY_MAX_SCHEMA_BYTES=16384
# Dev/test only: host[:port] list allowed over plain http and on private addresses
STUDIX_MCP_GATEWAY_INSECURE_HOSTS=
# Connector bearer tokens: a connector with secretRef "env:STUDIX_CONNECTOR_SECRET_BRAND" reads this variable.
# Each token must be bound, or it is refused: the workspaces allowed to reference it and the only origin it is sent to.
# STUDIX_CONNECTOR_SECRET_<NAME>=
# STUDIX_CONNECTOR_SECRET_<NAME>_WORKSPACES=ws_...,ws_...
# STUDIX_CONNECTOR_SECRET_<NAME>_ORIGIN=https://tools.example.com
# Worker: connector tool (connector.tool) used to enrich drafted brands, e.g. brand.brand_lookup
STUDIX_BRAND_LOOKUP_TOOL=

# --- Media toolchain (optional binary overrides) ---
HYPERFRAMES_BIN=
# chrome-headless-shell binary (default: ~/.cache/hyperframes or ~/.cache/puppeteer)
HYPERFRAMES_BROWSER_PATH=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Multix media provider (image, video, lip-sync, upscale, voice, music, SFX) ---
# Path to the multix CLI; empty disables the provider. The image ships it and defaults this to
# /opt/multix/dist/cli.js, so leave it unset in container deployments.
MULTIX_BIN=
# Provider keys the worker passes to multix (only those of routes you use). A kind is advertised only
# when `multix check` reports its key. Media runs on Sume, image upscale on Atlas Cloud, audio on
# ElevenLabs, Fish or MiniMax, and voice also on OpenRouter speech (it reuses OPENROUTER_API_KEY above).
SUME_API_KEY=
ATLASCLOUD_API_KEY=
ELEVENLABS_API_KEY=
FISH_API_KEY=
MINIMAX_API_KEY=
# Default model per role as "<vendor>:<model>"; empty keeps the built-in default:
#   image sume:nano-banana-2.1, video sume:seedance-2-mini, lip-sync sume:sync-lipsync-2,
#   video upscale sume:topaz-video, image upscale atlas:atlascloud/image-upscaler,
#   voice elevenlabs:eleven_multilingual_v2 (or fish:/minimax:), music elevenlabs:music_v1 (or minimax:),
#   sfx elevenlabs:sound-effects
# A voice request in a language the default ElevenLabs model does not speak (e.g. vi on
# eleven_multilingual_v2) moves to elevenlabs:eleven_v3; a model a request names is refused instead.
MULTIX_IMAGE_MODEL=
MULTIX_VIDEO_MODEL=
MULTIX_LIPSYNC_MODEL=
MULTIX_VIDEO_UPSCALE_MODEL=
MULTIX_IMAGE_UPSCALE_MODEL=
MULTIX_VOICE_MODEL=
# Speech model per language, comma-separated <language>=<vendor>:<model>[@<voice>]. A voice request in a
# routed language that names no model runs there instead, e.g. expressive Vietnamese voice-over with
# delivery direction: vi=openrouter:fish-audio/drama-3 or vi=openrouter:google/gemini-3.8-flash-tts@Sulafat
MULTIX_VOICE_LANGUAGE_MODELS=
MULTIX_MUSIC_MODEL=
MULTIX_SFX_MODEL=
# Longest wait for one upstream job, in seconds (30..7200)
MULTIX_WAIT_TIMEOUT_SECONDS=900
# Let multix also read ~/.multix/.env. Local development only; keep false on servers.
MULTIX_ALLOW_HOME_ENV=false

# --- QA measurement tools (tools/qa) ---
# Interpreter with studix-qa installed (default: tools/qa/.venv, created by `pnpm test:qa`; see docs/QA.md)
STUDIX_QA_PYTHON=

# --- Observability ---
OTEL_SERVICE_NAME=studix
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Mock MCP server (apps/mock-mcp, local connector for development and tests) ---
MOCK_MCP_PORT=
MOCK_MCP_HOST=127.0.0.1
# When set, the mock requires this bearer token
MOCK_MCP_BEARER=

# --- Tests ---
# Admin connection used to create throwaway test databases (defaults to DATABASE_URL)
TEST_DATABASE_URL=
# Set to 1 to run the opt-in `live` vitest project against paid APIs
STUDIX_LIVE=
