+// Studix: page scripts must not reach any network from the capture browser. Every request goes to a proxy
+// that does not exist and fails without a DIRECT fallback; only the producer's file server
+// (http://localhost:<port>) bypasses it. `<-loopback>` removes Chrome's implicit loopback bypass, so popups,
+// workers and WebSockets cannot reach other loopback ports either. Chrome also skips proxies for link-local
+// (169.254.0.0/16, fe80::/10) targets; the resolver rules stop those, failing every host name and IP literal
+// except the name "localhost". WebRTC may only use the dead proxy, so no UDP leaves either.
+export function captureNetworkIsolationArgs(serverUrl) {
+    const bypass = ["<-loopback>"];
+    if (serverUrl) {
+        const { hostname, port } = new URL(serverUrl);
+        bypass.push(`${hostname}:${port}`);
+    }
+    return [
+        // A name the resolver rules refuse, so not even a listener on a loopback port receives proxy traffic.
+        "--proxy-server=http://studix-capture-offline.invalid:9",
+        `--proxy-bypass-list=${bypass.join(";")}`,
+        "--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE localhost",
+        "--force-webrtc-ip-handling-policy=disable_non_proxied_udp",
+        "--webrtc-ip-handling-policy=disable_non_proxied_udp",
+    ];
+}
