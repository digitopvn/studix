+/**
+ * Studix: a capture browser reaches only the producer's file server. Every request goes to a
+ * proxy that cannot resolve, and nothing falls back to a direct connection; only the file
+ * server's `localhost:<port>` bypasses it. `<-loopback>` removes Chrome's implicit loopback
+ * bypass, so popups, workers and WebSockets cannot reach other loopback ports either. The
+ * resolver rules fail every lookup, IP literals included, except `localhost`, and WebRTC may
+ * not send UDP outside the dead proxy.
+ */
+export function captureNetworkIsolationArgs(serverUrl) {
+    const bypass = ["<-loopback>"];
+    if (serverUrl) {
+        const { hostname, port } = new URL(serverUrl);
+        bypass.push(`${hostname}:${port}`);
+    }
+    return [
+        "--proxy-server=http://studix-capture-offline.invalid:9",
+        `--proxy-bypass-list=${bypass.join(";")}`,
+        "--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE localhost",
+        "--force-webrtc-ip-handling-policy=disable_non_proxied_udp",
+    ];
+}
