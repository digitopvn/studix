+// Studix: page scripts must not reach any network from the capture browser. Every destination goes to
+// a proxy that does not exist and fails without a DIRECT fallback. Chrome would skip the proxy for loopback and
+// link-local (169.254.0.0/16, fe80::/10) targets; "<-loopback>" removes those implicit bypass rules, and the
+// resolver rules also fail every host name and IP literal except the name "localhost", which the producer's
+// file server uses (http://localhost:<port>). WebRTC may only use the dead proxy, so no UDP leaves either.
+export const CAPTURE_NETWORK_ISOLATION_ARGS = [
+    "--proxy-server=socks5://127.0.0.1:9",
+    "--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE localhost",
+    "--force-webrtc-ip-handling-policy=disable_non_proxied_udp",
+    "--webrtc-ip-handling-policy=disable_non_proxied_udp",
+];
+// Studix: without "<-loopback>", a page could reach every loopback port of the worker through "localhost".
+// Only the producer's file server port bypasses the dead proxy; a browser without one (audio FX loads a
+// file: page) gets no bypass at all. This also covers WebSockets and workers, which request interception
+// cannot see.
+export function fileServerOnlyArgs(serverUrl) {
+    if (!serverUrl)
