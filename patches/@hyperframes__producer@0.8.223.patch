+/**
+ * Studix: whether a media src found in the live DOM names a file inside the project. Page scripts
+ * control these values, and the engine reads them on the host: it downloads URLs and accepts
+ * absolute or percent-encoded `../` paths. Only the file server's own URLs and plain relative
+ * paths that stay inside the project directory survive, under every percent-decoding.
+ */
+function isProjectMediaSrc(src, fileServer) {
+  if (!src || src === "about:blank") return true;
+  let path = src;
+  if (fileServer && src.startsWith(`${fileServer.url}/`)) {
+    path = src.slice(fileServer.url.length + 1);
+  } else if (/^[a-z][a-z0-9+.-]*:/i.test(src) || src.startsWith("//")) {
+    return false;
+  }
+  path = path.replace(/[?#][\s\S]*$/, "");
+  for (let i = 0; i < 4; i++) {
+    const unixPath = path.replace(/\\/g, "/");
+    if (unixPath.startsWith("/") || /^[a-z]:/i.test(unixPath) || unixPath.includes("\0")) return false;
+    if (unixPath.split("/").includes("..")) return false;
+    let decoded;
+    try {
+      decoded = decodeURIComponent(path);
+    } catch {
+      return false;
+    }
+    if (decoded === path) return true;
+    path = decoded;
+  }
+  return false;
+}
+function keepProjectMedia(browserMedia, fileServer, log) {
+  return browserMedia.filter((el) => {
+    if (isProjectMediaSrc(el.src, fileServer)) return true;
+    log.warn("Ignoring runtime media outside the project", { id: el.id, tagName: el.tagName });
+    return false;
+  });
+}
