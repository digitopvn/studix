+// Studix: page scripts can create media elements at runtime, and the engine reads or downloads their
+// sources on the host. Keep only paths that stay inside the project (or inline data: images).
+function isProjectMediaSrc(src) {
+  if (/^data:image\//i.test(src)) return true;
+  if (/^[a-z][a-z0-9+.-]*:/i.test(src) || /^[\\/]/.test(src)) return false;
+  let path = src.replace(/[?#][\s\S]*$/, "");
+  for (let i = 0; i < 4; i++) {
+    let decoded;
+    try {
+      decoded = decodeURIComponent(path);
+    } catch {
+      return false;
+    }
+    if (decoded === path) break;
+    path = decoded;
+  }
+  if (/%[0-9a-f]{2}/i.test(path) || /[\0:]/.test(path) || /^[\\/]/.test(path)) return false;
+  let depth = 0;
+  for (const segment of path.split(/[\\/]/)) {
+    if (segment === "..") depth--;
+    else if (segment !== "" && segment !== ".") depth++;
+    if (depth < 0) return false;
+  }
+  return path.length > 0;
