{
  "_comment": "MiniMax H3 first/last-frame image-to-video, ComfyUI API format. Flattened from the video_minimax_h3_i2v template (comfyui-workflow-templates). generate-video-via-comfyui.py fills prompt/size/length/seed/steps/files and drops nodes 2 (turbo LoRA), 7 (last frame) and 15 (audio decode) when they are not wanted.",
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3_fl2va_pruned_w6a8.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors", "strength_model": 1.0}},
  "3": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}},
  "4": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"}},
  "5": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
  "6": {"class_type": "LoadImage", "inputs": {"image": "first.png"}},
  "7": {"class_type": "LoadImage", "inputs": {"image": "last.png"}},
  "8": {"class_type": "MiniMaxH3ImageToVideo", "inputs": {"clip": ["3", 0], "vae": ["4", 0], "prompt": "", "width": 864, "height": 480, "length": 124, "first_frame": ["6", 0], "last_frame": ["7", 0]}},
  "9": {"class_type": "RandomNoise", "inputs": {"noise_seed": 1}},
  "10": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
  "11": {"class_type": "BasicScheduler", "inputs": {"model": ["2", 0], "scheduler": "simple", "steps": 8, "denoise": 1.0}},
  "12": {"class_type": "BasicGuider", "inputs": {"model": ["2", 0], "conditioning": ["8", 0]}},
  "13": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["9", 0], "guider": ["12", 0], "sampler": ["10", 0], "sigmas": ["11", 0], "latent_image": ["8", 1]}},
  "14": {"class_type": "VAEDecode", "inputs": {"samples": ["13", 0], "vae": ["4", 0]}},
  "15": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["13", 0], "vae": ["5", 0]}},
  "16": {"class_type": "CreateVideo", "inputs": {"images": ["14", 0], "fps": 24.0, "audio": ["15", 0]}},
  "17": {"class_type": "SaveVideo", "inputs": {"video": ["16", 0], "filename_prefix": "h3-local/clip", "format": "mp4"}}
}
