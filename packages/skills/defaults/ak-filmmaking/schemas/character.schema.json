{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character.schema.json",
  "title": "Character bible entry (bibles/characters/<id>.json)",
  "type": "object",
  "required": ["id", "name", "identity_version", "description", "canonical_hair", "references"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/asset_id"},
    "name": {"type": "string", "minLength": 1},
    "identity_version": {
      "description": "Bumped only by an intentional identity change; canonical references carry the version they depict.",
      "type": "integer",
      "minimum": 1
    },
    "description": {"type": "string", "minLength": 1},
    "age": {"type": "string"},
    "canonical_hair": {"type": "string", "minLength": 1},
    "accessories": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {"type": "string"},
        "voice_ref": {"description": "Opaque voice identifier owned by the voice provider skill.", "type": "string"}
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/reference_image"}
    }
  }
}
