{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alignment.schema.json",
  "title": "Forced alignment of one dialogue cue (audio/alignment/<cue_id>.json). Times are seconds from the cue start.",
  "type": "object",
  "required": ["cue_id", "sentences"],
  "additionalProperties": false,
  "properties": {
    "cue_id": {"$ref": "common.schema.json#/$defs/asset_id"},
    "sentences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
    "words": {"type": "array", "items": {"$ref": "#/$defs/span"}},
    "silences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "additionalProperties": false,
        "properties": {"start": {"$ref": "common.schema.json#/$defs/seconds"}, "end": {"$ref": "common.schema.json#/$defs/seconds"}}
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["text", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "start": {"$ref": "common.schema.json#/$defs/seconds"},
        "end": {"$ref": "common.schema.json#/$defs/seconds"}
      }
    }
  }
}
