{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beat-sheet.schema.json",
  "title": "Beat sheet (films/<slug>/beat-sheet.json)",
  "type": "object",
  "required": ["beats"],
  "additionalProperties": false,
  "properties": {
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scenes", "purpose", "dramatic_question", "emotional_state", "change"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^B[0-9]{2,3}$"},
          "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/scene_id"}},
          "purpose": {"type": "string", "minLength": 1},
          "dramatic_question": {"type": "string", "minLength": 1},
          "emotional_state": {"type": "string", "minLength": 1},
          "change": {"description": "The reveal or turn this beat delivers.", "type": "string", "minLength": 1},
          "sound_intent": {"type": "string"},
          "music_theme": {"$ref": "common.schema.json#/$defs/asset_id"}
        }
      }
    }
  }
}
